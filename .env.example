# Copiá este archivo como .env (está en .gitignore) y completá los valores.
# Generá secretos con: openssl rand -base64 48

MYSQL_DATABASE=stockly
MYSQL_USER=stockly
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Clave HMAC para firmar los JWT (mínimo 32 caracteres)
JWT_KEY=

# Datos demo: si SEED_DEMO_PASSWORD queda vacío se genera una aleatoria y se muestra en los logs de la API
SEED_ENABLED=true
SEED_DEMO_PASSWORD=

SWAGGER_ENABLED=false
CLIENT_PORT=8080
PUBLIC_URL=http://localhost:8080
