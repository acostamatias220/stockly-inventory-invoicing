<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- Noise we accept on purpose: XML docs, culture-specific string ops in tests, logging perf hints -->
    <NoWarn>$(NoWarn);CS1591;CA1848;CA1716;CA1711;CA1062;CA2007;CA1031;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1724;CA1861;CA1819;CA2227;CA1002;CA1707;CA1515;CA1056;CA1054;CA1034;CA1822;CA1812;CA1852;CA1869;CA1863;CA1032;CA1064;CA1720;CA1873</NoWarn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
</Project>
